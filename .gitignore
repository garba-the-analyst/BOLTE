# BOLTE — root gitignore. Docs, specs, site and assets are committed.
# Regenerable bulk and local-only data stay out (reinstall/fetch locally).

# Deps & build outputs (reproducible via npm / cargo / pip)
**/node_modules/
**/dist/
**/src-tauri/target/
**/src-tauri/gen/
**/python-sidecar/venv/
**/__pycache__/
**/.pytest_cache/
*.pyc
*.local

# Member PII — NEVER commit. Full questionnaire answers (emails, phones,
# addresses, DOBs, matric IDs, portraits) live in docs/05-people/private/
# on founders' machines only. Public docs carry consent-level names only.
docs/05-people/private/
members-*.json
members-*.csv
bolte-questionnaire-*.json
bolte-questionnaire-*.csv

# Local Pages preview bundle (see build-scripts/package-pages.sh)
_pages/

# OS / editor
.DS_Store
Thumbs.db
